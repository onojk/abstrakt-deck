#!/usr/bin/make -f

%:
	dh $@ --buildsystem=cargo

override_dh_auto_build:
	# --ignore-rust-version: several deps (egui/egui-wgpu 0.29, naga 22, ...)
	# declare rust-version >= 1.76 but compile cleanly on noble's rustc 1.75.
	# The pinned versions are chosen so they actually build on 1.75; this flag
	# only suppresses cargo's advisory rust-version gate.
	# No --locked: dh_auto_configure (dh-cargo cargo.pm) removes Cargo.lock, so
	# the offline build regenerates it from the vendored sources (which pin the
	# exact versions), reproducing the committed v3 lock.
	cargo build --offline --release --ignore-rust-version

override_dh_auto_install:
	# dh-cargo's default install runs `cargo install`, a FRESH cargo invocation
	# that re-resolves without our --ignore-rust-version and re-trips the
	# advisory MSRV gate (e.g. epaint_default_fonts 0.29.1 declares rust-version
	# 1.76 but compiles fine on 1.75). The binary was already built by
	# override_dh_auto_build, so install it directly. Locate it with find: the
	# dh-cargo wrapper may build with --target (-> target/<triple>/release/) or
	# without (-> target/release/), so match either.
	install -Dm755 \
		"$$(find target -type f -name abstrakt-deck -path '*release/abstrakt-deck' | head -n1)" \
		debian/abstrakt-deck/usr/bin/abstrakt-deck

override_dh_auto_test:
	# Skip test runner during package build

override_dh_clean:
	# Preserve vendored *.orig / *.rej files. dh_clean deletes "*.orig" and
	# "*.rej" as quilt patch detritus, but every vendored crate ships a
	# Cargo.toml.orig listed in its .cargo-checksum.json; deleting them breaks
	# cargo's offline checksum verification on the buildd. -X excludes any
	# filename containing the item from deletion.
	dh_clean -X.orig -X.rej
